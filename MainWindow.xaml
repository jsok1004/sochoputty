<Window x:Class="SochoPutty.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Socho Terminal Manager" Height="750" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                     ResizeBorderThickness="5"
                     UseAeroCaptionButtons="False"
                     NonClientFrameEdges="None"
                     GlassFrameThickness="0"
                     CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/> <!-- 커스텀 타이틀바 -->
            <RowDefinition Height="Auto"/> <!-- 메뉴바 -->
            <RowDefinition Height="Auto"/> <!-- 툴바 -->
            <RowDefinition Height="*"/> <!-- 메인 컨텐츠 -->
        </Grid.RowDefinitions>
        
        <!-- 커스텀 타이틀바 -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- 아이콘과 타이틀 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Image Source="app.ico" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Socho Terminal Manager"
                          FontSize="14"
                          FontWeight="Normal"
                          Foreground="{DynamicResource TitleBarForeground}" 
                          VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- 윈도우 컨트롤 버튼 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Name="btnMinimize" 
                        Width="46" Height="32" 
                        Background="Transparent" 
                        BorderThickness="0"
                        Foreground="{DynamicResource TitleBarForeground}"
                        Click="MinimizeWindow_Click"
                        ToolTip="최소화">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TitleBarButtonHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TitleBarButtonPressed}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="🗕" FontSize="12"/>
                </Button>
                
                <Button Name="btnMaximize" 
                        Width="46" Height="32" 
                        Background="Transparent" 
                        BorderThickness="0"
                        Foreground="{DynamicResource TitleBarForeground}"
                        Click="MaximizeWindow_Click"
                        ToolTip="최대화">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TitleBarButtonHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TitleBarButtonPressed}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Name="btnMaximizeIcon" Text="🗖" FontSize="12"/>
                </Button>
                
                <Button Name="btnRestore" 
                        Width="46" Height="32" 
                        Background="Transparent" 
                        BorderThickness="0"
                        Foreground="{DynamicResource TitleBarForeground}"
                        Click="RestoreWindow_Click"
                        ToolTip="이전 크기로 복원"
                        Visibility="Collapsed">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TitleBarButtonHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TitleBarButtonPressed}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="🗗" FontSize="12"/>
                </Button>
                
                <Button Name="btnClose" 
                        Width="46" Height="32" 
                        Background="Transparent" 
                        BorderThickness="0"
                        Foreground="{DynamicResource TitleBarForeground}"
                        Click="CloseWindow_Click"
                        ToolTip="닫기">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E81123"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#F1707A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="🗙" FontSize="12"/>
                </Button>
            </StackPanel>
        </Grid>
       
        <!-- 툴바 -->
        <Menu Grid.Row="1" Background="{DynamicResource MenuBackground}">
            <MenuItem Header="도구(_T)">
                <MenuItem Header="설정(_S)" Click="Settings_Click"/>
                <Separator/>
                <MenuItem Header="디버그(_D)">
                    <MenuItem Header="디버그 로그 보기" Click="ShowDebugLog_Click"/>
                    <MenuItem Header="로그 폴더 열기" Click="OpenLogFolder_Click"/>
                    <MenuItem Header="로그 초기화" Click="ClearDebugLog_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="정보(_A)" Click="About_Click"/>
            </MenuItem>
            <MenuItem Header="새 연결(_N)" Click="NewConnection_Click"/>
            <MenuItem Header="연결 관리(_M)" Click="ManageConnections_Click"/>
            <ComboBox Name="cmbQuickConnect" Width="180" 
                                  SelectionChanged="QuickConnect_SelectionChanged"
                                  IsEditable="True"
                                  Text="빠른 연결 선택..."/>
            <MenuItem Header="🔗" Click="QuickConnect_Click"/>
            <MenuItem Header="⬚분할 해제(_Q)" Click="UnsplitAll_Click"/>
            <MenuItem Header="↕가로 분할(_A)" Click="SplitHorizontal_Click"/>
            <MenuItem Header="↔새로 분할(_S)" Click="SplitVertical_Click"/>
            <MenuItem Header="🔠4화면 분할(_D)" Click="SplitQuad_Click"/>
        </Menu>
        
        <!-- 메인 컨텐츠 영역 -->
        <Grid Grid.Row="3" Name="splitContainer">
            <!-- 분할 영역들이 동적으로 추가될 Grid -->
            <!-- 기존 TabControl 제거 - SplitManager가 모든 것을 관리 -->
        </Grid>
    </Grid>
</Window> 